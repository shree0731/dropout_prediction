# ==============================================================================
# AI Dropout Prediction Microservice Backend Configuration Example
# Copy this file to .env and configure real credentials for your environment.
# NEVER commit or share populated .env files with real credentials!
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Service-to-Service Security API Key (Required - Min 32 chars)
# Must match AI_SERVICE_API_KEY in the ERP backend.
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace_with_shared_service_api_key_at_least_32_chars

# Browser Session Secret (Required - Min 32 chars, MUST NOT equal API_KEY)
# Used to sign short-lived session tokens for frontend clients.
SESSION_SECRET=replace_with_distinct_session_secret_at_least_32_chars

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database Role Marker (Must be 'ai' for standalone AI service)
APP_DB_ROLE=ai

# MongoDB Connection URI (for MeetingRequests & logging)
# Local: mongodb://localhost:27017/ai_dropout_prediction
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_dropout_prediction?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ai_dropout_prediction

# Internal Python FastAPI ML Service Endpoint
ML_SERVICE_URL=http://localhost:8001

# ERP Integration Base URL & Service Key
ERP_BASE_URL=http://localhost:5000
ERP_SERVICE_API_KEY=replace_with_shared_erp_service_api_key_at_least_32_chars

# Path to Single-Sourced Serialized ML Models (used by predictor engine)
MODEL_DIR=../models

# Optional Google Gemini API Key (for conversational empathetic advisor)
# If unset, the chatbot engine gracefully degrades to rule-based intervention guidance
GEMINI_API_KEY=replace_with_gemini_api_key_if_available
